---
import '@/styles/global.css'

const { class: className } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Adhoc Records</title>
		<meta name="description" content="Personal record collection and jukebox" />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="icon"
			href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>💿</text></svg>"
		/>
	</head>
</html>
<body>
	<header>
		<nav aria-label="Primary">
			<a href="https://theadhocracy.co.uk">theAdhocracy</a>
			<div>💿</div>
			<div>
				<a href="/">Collection</a>
				<a href="/stats">Statistics</a>
			</div>
		</nav>
	</header>

	<main id={className}>
		<slot />
	</main>

	<footer>
		<p>Powered by 🎼</p>
	</footer>
</body>

<style>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;

		background-image: repeating-linear-gradient(
			to bottom,
			transparent,
			transparent 3px,
			rgba(172, 172, 172, 0.01) 3px,
			rgba(172, 172, 172, 0.01) 6px,
			transparent 9px
		);

		main {
			flex: 1;
			overflow: hidden;
		}

		header,
		footer,
		main {
			width: 100%;
		}
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		max-width: 70rem;
		margin-inline: auto;
		padding-block-start: 1rem;
		padding-inline: 1rem;
		place-content: space-between;

		a {
			--underline-color: #259e54;
			--underline-color-focus: #28a5d6;

			text-underline-position: auto;
			text-decoration-line: underline;
			text-decoration-color: var(--underline-color);
			text-decoration-thickness: 3px;
			text-underline-offset: 0.2rem;

			&:hover,
			&:focus {
				color: #354797;
				text-decoration-color: var(--underline-color-focus);
				outline: none;
			}

			&:focus {
				margin-block-start: -3px;
				border-block-start: 3px solid var(--underline-color-focus);
			}
		}

		& :last-child {
			display: flex;
			gap: 1rem;
			flex-wrap: wrap;
		}
	}

	footer {
		display: flex;
		place-content: center;
		place-items: center;
		min-height: 5rem;
		margin-block-start: 3rem;
		z-index: 1;
		background-color: #2c2727;
		color: #ffffff;
		text-align: center;
	}
</style>
