---
const { albums, hidden, minRange = 1000 } = Astro.props

// Graph axis
const upperBound = Math.max(minRange, Math.ceil(albums[0]?.playcount / 100) * 100)
---

<ol
	class:list={['top-album', hidden && 'hidden']}
	style={`--axis-upper-bound: ${upperBound}`}
	role="list"
>
	{
		albums.map((album: any, index: number) => {
			// Remove soundtrack statements
			if (album.name.toLowerCase().includes('soundtrack')) {
				album.name = album.name.replace(/-?\s*\(soundtrack.*\s*/gi, '')
			}

			// Note: index is zero-indexed (hence 9 is threshold)
			const counter = index >= 9 ? index + 1 : `0${index + 1}`

			return (
				<li style={`--percentage: ${(album.playcount / upperBound) * 100}%`}>
					<p>{counter}</p>
					<img src={album.image[3]['#text']} alt="" width="100" height="100" />
					<dl>
						<dt>Album:</dt>
						<dd>{album.name}</dd>
						<dt>Artist:</dt>
						<dd>{album.artist.name}</dd>
					</dl>
					<p class="total">Played {album.playcount} times</p>
				</li>
			)
		})
	}
</ol>

<style>
	ol {
		list-style: decimal;
		display: flex;
		flex-direction: column;
		padding: 0;
		margin: 0;
	}

	li {
		display: grid;
		grid-template-columns: 2rem 5rem 20rem 1fr;

		p,
		img,
		dt,
		dl,
		dd {
			margin: 0;
			padding: 0;
		}

		img {
			width: 100%;
			height: auto;
			aspect-ratio: 1 / 1;
			padding: 0.25rem;
		}

		p {
			height: min-content;
		}

		& > p:first-child {
			place-self: center start;
			border-block: 1px solid #b45a0b;
			font-size: 0.825rem;
			color: #757575;
			line-height: 2;
		}

		dl {
			display: grid;
			grid-template-columns: max-content 1fr;
			gap: 0 0.5rem;
			height: max-content;
			align-self: center;
			padding-inline: 1rem;
			border-inline-end: 1px solid #76b3c1;
		}

		dt {
			text-align: end;
			color: #757575;
			font-size: 0.825rem;
			line-height: 1.75;
		}

		dd {
			color: #b45a0b;
			font-weight: 600;
		}

		.total {
			width: var(--percentage);
			padding: 0.5rem;
			white-space: nowrap;
			align-self: center;
			color: #757575;
			font-size: 0.875rem;
		}

		.total::after {
			content: '';
			display: block;
			width: 100%;
			height: 0.8rem;
			margin-block-start: 0.25rem;
			background-color: #76b3c1;
		}
	}
</style>
