---
import Album, { type RecordAPI } from '@/components/Album.astro'

const { albums, loading } = Astro.props as { albums: RecordAPI[]; loading: boolean }
---

<section class="album-grid" aria-busy={loading}>
	{
		albums.map((album) => {
			return <Album record={album} />
		})
	}
</section>

<style>
	.album-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		grid-template-rows: min-content min-content 1fr;
		gap: 3rem clamp(3rem, 4.5rem, 6rem);
	}
</style>
