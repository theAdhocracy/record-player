---
const { total } = Astro.props
---

<search role="search">
	<form>
		<label for="search">Search Albums</label>
		<input type="search" id="search" name="search" />
		<button type="submit" aria-label="Submit">🔍</button>
		<button type="button" aria-label="Randomise">🎲</button>
	</form>
	<p class="sr-only" role="status">{total} results</p>
</search>

<script>
	// Function: filter album grid based on search term
	export function filterAlbumGrid(search: string) {
		const albumGrid = document.querySelector('.album-grid')
		const albums = albumGrid?.querySelectorAll('article')
		if (!albums || !albumGrid) return

		// Set aria-busy attribute
		albumGrid.setAttribute('aria-busy', 'true')

		// Loop through albums and hide/show based on search term
		;[...albums].forEach((album: any) => {
			const albumTitle = album.querySelector('h2')?.textContent?.toLowerCase() || ''
			const albumArtist = album.querySelector('h3')?.textContent?.toLowerCase() || ''
			const searchTerm = search.toLowerCase()

			if (albumTitle.includes(searchTerm) || albumArtist.includes(searchTerm)) {
				album.style.display = 'block'
			} else {
				album.style.display = 'none'
			}
		})

		// Remove aria-busy attribute
		albumGrid.removeAttribute('aria-busy')
	}

	// Event: trigger filtering on search
	const searchBox = document.querySelector('search')
	const searchAlert = searchBox?.querySelector('p[role="status"]')
	const searchInput = searchBox?.querySelector('#search') as HTMLInputElement | null

	searchInput?.addEventListener('input', (event) => {
		const target = event.target as HTMLInputElement
		filterAlbumGrid(target.value)

		// Update live region with number of results
		const albumGrid = document.querySelector('.album-grid')
		const visibleAlbums =
			albumGrid?.querySelectorAll('article:not([style*="display: none"])').length || 0
		if (searchAlert) {
			searchAlert.textContent = `${visibleAlbums} results`
		}
	})

	// Event: randomise album grid order
	const randomButton = searchBox?.querySelector('button[aria-label="Randomise"]')
	randomButton?.addEventListener('click', () => {
		const albumGrid = document.querySelector('.album-grid')
		const albums = albumGrid?.querySelectorAll('article')
		if (!albums || !albumGrid) return

		// Set aria-busy attribute
		albumGrid.setAttribute('aria-busy', 'true')

		// Convert NodeList to array and shuffle
		const albumsArray = Array.from(albums)
		for (let i = albumsArray.length - 1; i > 0; i--) {
			// Fisher-Yates shuffle
			const j = Math.floor(Math.random() * (i + 1))
			;[albumsArray[i], albumsArray[j]] = [albumsArray[j], albumsArray[i]]
		}

		// Clear existing albums and re-append in new order
		albumGrid.innerHTML = ''
		albumsArray.forEach((album) => {
			albumGrid.appendChild(album)
		})

		// Remove aria-busy attribute
		albumGrid.removeAttribute('aria-busy')
	})

	// Event: on page load, check URL for search parameter
	window.addEventListener('DOMContentLoaded', () => {
		const params = new URLSearchParams(window.location.search)
		const searchParam = params.get('search')
		if (searchParam && searchInput) {
			searchInput.value = searchParam
			filterAlbumGrid(searchParam)
		}
	})
</script>

<style>
	search {
		form {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			place-content: center;
			place-items: center;
			text-align: center;
		}

		label {
			flex-basis: 100%;
			font-size: 0.825rem;
			color: #757575;
		}

		input {
			max-width: 100%;
			padding: 0.25rem 0.5rem;
			border: 3px double #354797;
		}

		button {
			aspect-ratio: 1;
			padding: 0.15rem;
			background: none;
			border: 3px double #354797;
			line-height: 1;
		}

		:is(input, button):focus {
			outline: 3px solid transparent;
			border-style: solid;
		}
	}
</style>
