---
import Layout from '@/layouts/Layout.astro'
import AlbumGrid from '@/components/AlbumGrid.astro'
import type { RecordAPI } from '@/components/Album.astro'
import Toggle from '@/components/Toggle.astro'
import { fetchCraftAPI } from '@/utils/CraftAPI'

// Fetch albums
const records = await fetchCraftAPI('/music/records')

// Function: date based sorting
const dateSort = (album1: RecordAPI, album2: RecordAPI) => {
	if (album1.date < album2.date) return 1
	if (album1.date > album2.date) return -1
	return 0
}

// Function: alphabetical sorting
const alphaSort = (album1: RecordAPI, album2: RecordAPI) => {
	// Remove "the" from artist name
	const artist1 = album1.artist[0].replace(/^the /i, '')
	const artist2 = album2.artist[0].replace(/^the /i, '')

	// First sort by artist name
	if (artist1 < artist2) return -1
	if (artist1 > artist2) return 1

	// Then by album title
	if (album1.title < album2.title) return -1
	if (album1.title > album2.title) return 1

	// Otherwise it's where it should be
	return 0
}

// Derive rankings for both sorting methods
const alphabeticalRecords = [...records].sort(alphaSort)
const dateRecords = [...records].sort(dateSort)

// Add rankings to albums
const rankedRecords = records.map((album: RecordAPI) => {
	return {
		...album,
		alphaRank: alphabeticalRecords.findIndex((item: RecordAPI) => item.id === album.id) + 1,
		dateRank: dateRecords.findIndex((item: RecordAPI) => item.id === album.id) + 1
	}
})
---

<Layout class="homepage">
	<h1>
		<span>An ad hoc</span> Hall of Records
	</h1>
	<p>
		<span class="dfn">
			&#10100; <dfn title="discophilia">dis•co•phil•i•a</dfn> &#10101;
		</span>{' '}
		The enjoyment, collection, and study of musical recordings, often in the form of phonograph records
		and/or CDs.
	</p>
	<p>
		Or, to put it another way:{' '}
		<a href="https://theadhocracy.co.uk/" class="h-card"> my </a>{' '}
		music collection.
	</p>
	<Toggle />
	<AlbumGrid albums={rankedRecords} loading={true} />
</Layout>

<script>
	import { sortAlbumGrid } from '@/utils/SortAlbums'

	// Set sort order based on localStorage or default to 'date'
	const sort = localStorage.getItem('sort') || 'date'

	const sortToggleElement = document.querySelector('#sort-toggle') as HTMLInputElement | null
	if (sortToggleElement) {
		sortToggleElement.checked = sort === 'date'
		sortAlbumGrid(sort)
	}
</script>

<style is:global>
	#homepage {
		max-width: 110rem;
		margin: 0 auto;
		padding: 0 1rem;

		h1,
		p {
			grid-column: 1 / -1;
			text-align: center;
		}

		dfn,
		span.dfn {
			color: #354797;
		}

		h1 {
			margin-bottom: 3rem;
			font-size: 5rem;
			line-height: 0.85;

			span {
				display: block;
				margin-bottom: 0.2em;
				font-size: 0.35em;
				text-transform: lowercase;
				font-weight: 400;
				font-style: italic;
				color: #929292;
			}
		}

		p {
			margin: 1rem 0 3rem;

			:last-of-type {
				margin-bottom: 2rem;
			}

			a {
				font-weight: bold;
				text-underline-position: auto;
				text-decoration-line: underline;
				text-decoration-color: #354797;
				text-decoration-thickness: 3px;

				:hover,
				:focus {
					color: #354797;
					text-decoration-color: #000000;
					outline: none;
				}
			}
		}

		@media screen and (min-width: 500px) {
			padding: 0 5rem;
		}
	}
</style>
