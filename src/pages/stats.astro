---
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import Toggle from '@/components/Toggle.astro'
import TopAlbums from '@/components/stats/TopAlbums.astro'
import TopArtists from '@/components/stats/TopArtists.astro'
import { queryTopAlbums, queryTopArtists } from '@/utils/LastFm'

// Check for user cookie (fallback to environment variable)
const cookies = Astro.request.headers.get('cookie') ?? ''
const userMatch = cookies.match(/user=([^;]+)/)
const user = userMatch ? decodeURIComponent(userMatch[1]) : import.meta.env.LASTFM_USER

// Fetch top albums
const topAlbumsAllTime = await queryTopAlbums(user, 'overall', 15)
const topAlbumsYear = await queryTopAlbums(user, '12month', 15)

// Fetch top artists
const topArtistsAllTime = await queryTopArtists(user, 'overall', 15)
const topArtistsYear = await queryTopArtists(user, '12month', 15)
---

<Layout class="stats-page">
	<header>
		<h1>Musical Notes</h1>
		<p>
			A collection of stats and data about
			<a href="https://theadhocracy.co.uk/" class="h-card"> my</a>
			music listening habits.
		</p>
		<nav aria-label="Data blocks">
			<a href="#album-stats">[ Top Albums ]</a>
			<a href="#artist-stats">[ Top Artists ]</a>
		</nav>
	</header>
	<section id="album-stats">
		<header class="togglable">
			<h2>Top Albums</h2>
			<Toggle title="time span" options={['all time', '12 months']} id="album-toggle" />
		</header>
		<TopAlbums albums={topAlbumsAllTime} />
		<TopAlbums albums={topAlbumsYear} minRange={500} hidden />
	</section>
	<section id="artist-stats">
		<header class="togglable">
			<h2>Top Artists</h2>
			<Toggle title="time span" options={['all time', '12 months']} id="artist-toggle" />
		</header>
		<TopArtists artists={topArtistsAllTime} />
		<TopArtists artists={topArtistsYear} minRange={500} hidden />
	</section>
</Layout>

<script>
	// Function: Trigger charts via toggle component
	function setupChartToggle(toggleId: string, chartClass: string) {
		// Get toggle
		const toggle = document.querySelector(`#${toggleId}`) as HTMLInputElement | null
		if (!toggle) return

		// Get charts
		const chart1 = document.querySelector(
			`.${chartClass}:nth-of-type(1)`
		) as HTMLOListElement | null
		const chart2 = document.querySelector(
			`.${chartClass}:nth-of-type(2)`
		) as HTMLOListElement | null
		if (!chart1 || !chart2) return

		// Set event listener for toggle
		toggle.addEventListener('change', () => {
			// Invert visible chart
			chart1.classList.toggle('hidden')
			chart2.classList.toggle('hidden')
		})
	}

	// Initialise toggles
	setupChartToggle('album-toggle', 'top-album')
	setupChartToggle('artist-toggle', 'top-artist')
</script>

<style is:global>
	#stats-page {
		max-width: 110rem;
		margin: 0 auto;
		padding: 0 1rem;

		header {
			grid-column: 1 / -1;
			text-align: center;

			dfn,
			span.dfn {
				color: #354797;
			}

			span.dfn {
				display: block;
				margin-block-end: 1rem;
			}

			h1 {
				margin-block-end: 3rem;
				font-size: 5rem;
				line-height: 0.85;

				span {
					display: block;
					margin-block-end: 0.2em;
					font-size: 0.35em;
					text-transform: lowercase;
					font-weight: 400;
					font-style: italic;
					color: #929292;
				}
			}

			p {
				margin: 1rem auto 3rem;
				max-width: 70ch;

				&:last-of-type {
					margin-block-end: 2rem;
				}
			}

			a {
				--underline-color: #354797;
				--underline-color-focus: #000000;

				font-weight: bold;
				text-underline-position: auto;
				text-decoration-line: underline;
				text-decoration-color: var(--underline-color);
				text-decoration-thickness: 3px;

				&:hover,
				&:focus {
					color: #354797;
					text-decoration-color: var(--underline-color-focus);
					outline: none;
				}
			}

			nav {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem 2rem;
				max-width: max-content;
				margin-inline: auto;

				a {
					--underline-color: #b45a0b;
					--underline-color-focus: #76b3c1;
				}
			}
		}

		h2 {
			--shadow-fore: #d3eaef;
			--shadow-aft: #f5c79f;

			margin: 0;
			font-size: 3rem;
			filter: drop-shadow(-8px -5px var(--shadow-fore)) drop-shadow(8px 5px var(--shadow-aft));
		}

		section {
			max-width: 60rem;
			margin-inline: auto;
		}

		& > :is(section, header) + section {
			margin-block-start: 7rem;
		}

		.togglable {
			display: flex;
			flex-wrap: wrap;
			place-content: space-between;
			margin-block: 3rem;
		}

		@media screen and (min-width: 500px) {
			padding: 0 5rem;
		}
	}
</style>
