---
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import Toggle from '@/components/Toggle.astro'
import TopAlbums from '@/components/stats/TopAlbums.astro'
import TopArtists from '@/components/stats/TopArtists.astro'
import {
	queryRecentTracks,
	queryTopAlbums,
	queryTopArtists,
	queryTrackTotals,
	queryUser
} from '@/utils/LastFm'
import Vinyl from '@/components/Vinyl.astro'

// Check for user cookie (fallback to environment variable)
const cookies = Astro.request.headers.get('cookie') ?? ''
const userMatch = cookies.match(/user=([^;]+)/)
const user = userMatch ? decodeURIComponent(userMatch[1]) : import.meta.env.LASTFM_USER

// Fetch user data
const userData = await queryUser(user)
const recentTracks = await queryRecentTracks(user, 4).then((data) => data.track)

// Generate track totals for year graph
const currentYear = new Date().getFullYear()
const years = Array.from({ length: 5 }, (_, i) => currentYear - 4 + i)

const yearTracks = await Promise.all(
	years.map(async (year) => ({
		year: year.toString(),
		tracks: await queryTrackTotals(user, `${year}-01-01`, `${year}-12-31`)
	}))
)

// Calculate largest number of tracks in a year for percentage calculations
const maxTracks =
	Math.ceil(
		Math.max(...yearTracks.map((item) => Number(String(item.tracks).replace(/,/g, '')))) / 1000
	) * 1000

// Fetch top albums
const topAlbumsAllTime = await queryTopAlbums(user, 'overall', 15)
const topAlbumsYear = await queryTopAlbums(user, '12month', 15)

// Fetch top artists
const topArtistsAllTime = await queryTopArtists(user, 'overall', 15)
const topArtistsYear = await queryTopArtists(user, '12month', 15)
---

<Layout class="stats-page">
	<header>
		<h1>Musical Notes</h1>
		<p>
			A collection of stats and data about
			<a href="https://theadhocracy.co.uk/" class="h-card"> my</a>
			music listening habits.
		</p>
		<nav aria-label="Data blocks">
			<a href="#album-stats">[ Top Albums ]</a>
			<a href="#artist-stats">[ Top Artists ]</a>
		</nav>
	</header>

	<div class="data-grid">
		<section id="last-fm">
			<h2>Last.fm Stats</h2>
			<dl>
				<dt>Last.fm Profile:</dt>
				<dd><a href={userData.url}>{userData.name}</a></dd>
				<dt>Scrobble Count:</dt>
				<dd>{Number(userData.playcount).toLocaleString()}</dd>
				<dt>Total Albums:</dt>
				<dd>{Number(userData.album_count).toLocaleString()}</dd>
				<dt>Total Artists:</dt>
				<dd>{Number(userData.artist_count).toLocaleString()}</dd>
			</dl>
			<h2>Scrobbles</h2>
			<ol>
				{
					yearTracks.map((item) => {
						const percentage = (Number(String(item.tracks).replace(/,/g, '')) / maxTracks) * 100

						return (
							<li style={`--percentage: ${percentage}%`}>
								<span>{item.year}</span> <span>{item.tracks}</span>
							</li>
						)
					})
				}
			</ol>
		</section>
		<section id="recent-tracks">
			<h2>Recently Played</h2>
			<ol>
				{
					recentTracks.map((track: any, index: number) => {
						// Check if currently playing
						const nowPlaying = track['@attr']?.nowplaying ? true : false
						// Note: index is zero-indexed (hence 9 is threshold)
						const counter = index >= 9 ? index + 1 : `0${index + 1}`
						if (index === 0) {
							return (
								<li>
									<div>
										<Vinyl
											cover={track.image[2]['#text']}
											slug="now-playing"
											trackCount={3}
											colour={'#000000'}
											isRotating={nowPlaying}
											isDecorative
										/>
									</div>
									<dl>
										<dt>Track:</dt>
										<dd>{track.name} </dd>
										<dt>Artist:</dt>
										<dd>{track.artist['#text']}</dd>
										<dt>Album:</dt>
										<dd>{track.album['#text']}</dd>
									</dl>
								</li>
							)
						}
						return (
							<li>
								<span>{counter}</span> {track.name} — {track.artist['#text']} —{' '}
								{track.album['#text']}
							</li>
						)
					})
				}
			</ol>
		</section>
	</div>

	<section id="album-stats">
		<header class="togglable">
			<h2>Top Albums</h2>
			<Toggle title="time span" options={['all time', '12 months']} id="album-toggle" />
		</header>
		<TopAlbums albums={topAlbumsAllTime} />
		<TopAlbums albums={topAlbumsYear} minRange={500} hidden />
	</section>

	<section id="artist-stats">
		<header class="togglable">
			<h2>Top Artists</h2>
			<Toggle title="time span" options={['all time', '12 months']} id="artist-toggle" />
		</header>
		<TopArtists artists={topArtistsAllTime} />
		<TopArtists artists={topArtistsYear} minRange={500} hidden />
	</section>
</Layout>

<script>
	// Function: Trigger charts via toggle component
	function setupChartToggle(toggleId: string, chartClass: string) {
		// Get toggle
		const toggle = document.querySelector(`#${toggleId}`) as HTMLInputElement | null
		if (!toggle) return

		// Get charts
		const chart1 = document.querySelector(
			`.${chartClass}:nth-of-type(1)`
		) as HTMLOListElement | null
		const chart2 = document.querySelector(
			`.${chartClass}:nth-of-type(2)`
		) as HTMLOListElement | null
		if (!chart1 || !chart2) return

		// Set event listener for toggle
		toggle.addEventListener('change', () => {
			// Invert visible chart
			chart1.classList.toggle('hidden')
			chart2.classList.toggle('hidden')
		})
	}

	// Initialise toggles
	setupChartToggle('album-toggle', 'top-album')
	setupChartToggle('artist-toggle', 'top-artist')
</script>

<style is:global>
	#stats-page {
		max-width: 110rem;
		margin: 0 auto;
		padding: 0 1rem;

		header {
			grid-column: 1 / -1;
			text-align: center;

			dfn,
			span.dfn {
				color: #354797;
			}

			span.dfn {
				display: block;
				margin-block-end: 1rem;
			}

			h1 {
				margin-block-end: 3rem;
				font-size: 5rem;
				line-height: 0.85;

				span {
					display: block;
					margin-block-end: 0.2em;
					font-size: 0.35em;
					text-transform: lowercase;
					font-weight: 400;
					font-style: italic;
					color: #929292;
				}
			}

			p {
				margin: 1rem auto 3rem;
				max-width: 70ch;

				&:last-of-type {
					margin-block-end: 2rem;
				}
			}

			nav {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem 2rem;
				max-width: max-content;
				margin-inline: auto;

				a {
					--underline-color: #b45a0b;
					--underline-color-focus: #76b3c1;
				}
			}
		}

		a {
			--underline-color: #354797;
			--underline-color-focus: #000000;

			font-weight: bold;
			text-underline-position: auto;
			text-decoration-line: underline;
			text-decoration-color: var(--underline-color);
			text-decoration-thickness: 3px;

			&:hover,
			&:focus {
				color: #354797;
				text-decoration-color: var(--underline-color-focus);
				outline: none;
			}
		}

		h2 {
			--shadow-fore: #d3eaef;
			--shadow-aft: #f5c79f;

			margin: 0;
			font-size: 3rem;
			filter: drop-shadow(-8px -5px var(--shadow-fore)) drop-shadow(8px 5px var(--shadow-aft));
		}

		section {
			max-width: 60rem;
			margin-inline: auto;
		}

		& > :is(section, header) + section {
			margin-block-start: 7rem;
		}

		.togglable {
			display: flex;
			flex-wrap: wrap;
			place-content: space-between;
			margin-block: 3rem;
		}

		.data-grid {
			--grid-col: 18rem;

			container: data-grid / inline-size;

			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--grid-col)), 1fr));
			gap: 2rem 3rem;
			max-width: 60rem;
			margin-block: 4rem 3rem;
			margin-inline: auto;
			padding-inline: clamp(0.25rem, calc(0.25rem + 1vw), 3rem);
		}

		#last-fm,
		#recent-tracks {
			width: 100%;
			margin-block: 0;

			h2 {
				font-size: 2rem;
				text-align: center;
				margin-block-end: 1rem;
			}

			dl {
				display: grid;
				grid-template-columns: max-content 1fr;
				gap: 0 1rem;
				height: max-content;
				place-self: center;
				padding-inline: 1rem;
			}

			dt {
				text-align: end;
				color: #757575;
				font-size: 0.825rem;
				line-height: 1.75;
			}

			dd,
			dd a {
				--underline-color: #b45a0b;
				--underline-color-focus: #76b3c1;

				margin: 0;
				color: #b45a0b;
				font-weight: 600;
			}
		}

		#last-fm {
			dl {
				grid-template-columns: 1fr 1fr;
			}

			dl + h2 {
				margin-block-start: 2rem;
			}

			ol {
				max-width: 22rem;
				margin-inline: auto;
				list-style: none;
				padding: 0;

				li {
					display: grid;
					grid-template-columns: max-content 1fr;
					align-items: center;
					width: var(--percentage);
					font-size: 0.825rem;
					color: #757575;

					span:first-child {
						display: flex;
						height: 75%;
						place-items: center;
						line-height: 1;
						margin-inline-end: 1rem;
						padding-inline-end: 0.5rem;
						border-inline-end: 1px solid #b45a0b;
					}

					span:nth-child(2)::after {
						content: '';
						display: block;
						width: 100%;
						height: 0.5rem;
						margin-block-start: 0.25rem;
						background-color: #76b3c1;
					}
				}

				li + li {
					margin-block-start: 0.25rem;
				}

				@container data-grid (width > 18rem) {
					padding-inline-start: 3rem;
				}
			}
		}

		#recent-tracks {
			max-width: 25rem;

			ol {
				padding: 0;
				margin: 0;
				list-style: none;
			}

			li:first-of-type {
				display: flex;
				flex-wrap: wrap;
				place-content: center;

				div {
					width: 6rem;
					max-height: 6rem;
					place-self: center;
				}
			}

			li {
				padding: 0.5rem;
				border-block-end: 1px solid #b45a0b;

				span {
					font-size: 0.825rem;
					color: #757575;
					line-height: 1;
				}
			}

			li:not(:first-of-type) {
				display: grid;
				grid-template-columns: max-content 1fr;
				gap: 1rem;
				align-items: center;
				padding-inline: 1rem;
			}
		}

		@media screen and (min-width: 500px) {
			padding: 0 5rem;
		}
	}
</style>
