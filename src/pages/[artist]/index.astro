---
import type { GetStaticPaths } from 'astro'
import type { RecordAPI } from '@/components/Album.astro'
import Layout from '@/layouts/Layout.astro'
import AlbumGrid from '@/components/AlbumGrid.astro'
import { adjustColour } from '@/utils/ColourAdjust'
import { fetchCraftAPI } from '@/utils/CraftAPI'

export type ArtistAPI = {
	id: number
	title: string
	slug: string
	albums: RecordAPI[]
	featured: RecordAPI[]
}

// Generate static pages
export const getStaticPaths = (async () => {
	const artists = await fetchCraftAPI('/music/artists')

	// Remove artists that don't have albums (featured artists only)
	const filteredArtists = artists.filter((artist: any) => artist.albums?.length > 0)

	return filteredArtists.map((artist: any) => {
		return {
			params: {
				artist: artist.slug
			},
			props: {
				artist: artist,
				error: false
			}
		}
	})
}) satisfies GetStaticPaths

// Fetch & calculate props for each page
const { artist, error } = Astro.props as {
	artist: ArtistAPI
	error: boolean
}

// Determine page colours
const accent = artist.albums[0].colour === '#000000' ? '#354797' : artist.albums[0].colour
const shadow = [adjustColour(accent, 70), adjustColour(accent, 120)]

// Combine albums and featured albums
const allAlbums = artist.albums.concat(artist.featured)
---

<Layout class="artist-page">
	<h1>{artist.title}</h1>
	<AlbumGrid albums={allAlbums} />
</Layout>

<style is:global define:vars={{ 'shadow-fore': shadow[0], 'shadow-aft': shadow[1] }}>
	#artist-page {
		max-width: 110rem;
		margin: 0 auto;
		padding: 0 1rem;

		h1 {
			margin-block-end: 3rem;
			margin-block-start: 3rem;
			text-align: center;
			font-size: 4rem;
			filter: drop-shadow(-8px -5px var(--shadow-fore)) drop-shadow(8px 5px var(--shadow-aft));
		}

		@media screen and (min-width: 600px) {
			padding: 0 5rem;

			h1 {
				font-size: clamp(4rem, 6rem, 8rem);
				line-height: 0.9;
				margin-block-end: 6rem;
			}
		}
	}
</style>
